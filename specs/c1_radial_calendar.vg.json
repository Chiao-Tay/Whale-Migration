{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Percentage of each species' sightings in each month, 2016-2025. Each slice is a month (January at the top, clockwise); slice length shows the share of that species' sightings.",
  "data": {
    "url": "data/c1_species_by_month.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number",
        "share_pct": "number",
        "species_total": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.month - 1",
      "as": "t0"
    },
    {
      "calculate": "datum.month",
      "as": "t1"
    },
    {
      "calculate": "datum.month - 0.5",
      "as": "tmid"
    },
    {
      "calculate": "datum.species_name + ' · ' + format(datum.species_total, ',') + ' sightings'",
      "as": "panel"
    }
  ],
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "species_total",
        "order": "descending"
      },
      "header": {
        "labelPadding": 8
      }
    }
  },
  "spacing": 24,
  "spec": {
    "width": 255,
    "height": 255,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "fill": null,
          "stroke": "#c5d2de",
          "strokeWidth": 1,
          "strokeDash": [
            3,
            3
          ],
          "tooltip": false,
          "radius": 66
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ],
              "range": [
                0,
                6.283185
              ]
            }
          },
          "theta2": {
            "field": "t1"
          }
        }
      },
      {
        "params": [
          {
            "name": "hoverMonth",
            "select": {
              "type": "point",
              "fields": [
                "month"
              ],
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ],
        "mark": {
          "type": "arc",
          "padAngle": 0.02,
          "cornerRadius": 2,
          "stroke": "#f3f7fa",
          "strokeWidth": 1
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ],
              "range": [
                0,
                6.283185
              ]
            }
          },
          "theta2": {
            "field": "t1"
          },
          "radius": {
            "field": "share_pct",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "domain": [
                0,
                75
              ],
              "range": [
                5,
                110
              ]
            }
          },
          "color": {
            "field": "species_name",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "Humpback Whale",
                "Southern Right Whale",
                "Blue Whale"
              ],
              "range": [
                "#2a78d6",
                "#eda100",
                "#1baf7a"
              ]
            }
          },
          "opacity": {
            "condition": {
              "param": "hoverMonth",
              "empty": true,
              "value": 1
            },
            "value": 0.3
          },
          "tooltip": [
            {
              "field": "species_name",
              "title": "Species"
            },
            {
              "field": "month_name",
              "title": "Month"
            },
            {
              "field": "share_pct",
              "title": "% of this species' sightings",
              "format": ".1f"
            },
            {
              "field": "records",
              "title": "Sightings",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "max",
                "field": "share_pct",
                "as": "max_share"
              }
            ],
            "groupby": [
              "species_name"
            ]
          },
          {
            "filter": "datum.share_pct === datum.max_share"
          },
          {
            "calculate": "'Busiest: ' + datum.month_name + ' (' + format(datum.share_pct, '.0f') + '%)'",
            "as": "peak_label"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 12,
          "fontWeight": 600,
          "fill": "#16212d",
          "tooltip": false
        },
        "encoding": {
          "x": {
            "value": 127
          },
          "y": {
            "value": 282
          },
          "text": {
            "field": "peak_label"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "radius": 126,
          "fontSize": 12,
          "fill": "#5f6b77",
          "tooltip": false
        },
        "encoding": {
          "theta": {
            "field": "tmid",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ],
              "range": [
                0,
                6.283185
              ]
            }
          },
          "text": {
            "field": "month_name"
          }
        }
      }
    ]
  },
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 13,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
