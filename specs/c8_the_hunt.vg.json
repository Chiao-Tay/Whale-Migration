{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Humpback whales caught at Australian whaling stations per year, 1925-1963.",
  "data": {
    "url": "data/c8_whaling_catches.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "catches": "number"
      }
    }
  },
  "width": 800,
  "height": 320,
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": 1928.6,
            "end": 1946.4
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#e2e9f0",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "scale": {
            "domain": [
              1924,
              1978
            ],
            "nice": false,
            "zero": false
          }
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1963.55
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#3f4b57",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              1924,
              1978
            ],
            "nice": false,
            "zero": false
          }
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 12,
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1924,
              1978
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "values": [
              1925,
              1930,
              1935,
              1940,
              1945,
              1950,
              1955,
              1960,
              1965
            ],
            "grid": false
          }
        },
        "y": {
          "field": "catches",
          "type": "quantitative",
          "stack": true,
          "title": "Humpbacks caught",
          "axis": {
            "tickCount": 5
          }
        },
        "color": {
          "field": "coast",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "West coast (WA)",
              "East coast (QLD, NSW, Norfolk Is.)"
            ],
            "range": [
              "#184f95",
              "#86b6ef"
            ]
          },
          "legend": {
            "orient": "top-left",
            "direction": "vertical",
            "labelLimit": 320
          }
        },
        "order": {
          "field": "coast",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "coast",
            "title": "Coast"
          },
          {
            "field": "catches",
            "title": "Humpbacks caught",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1964.3,
            "y": 1150,
            "text": [
              "1961 → 1963:",
              "1,483 → 91 caught.",
              "Too few whales left",
              "to find."
            ]
          },
          {
            "x": 1964.3,
            "y": 450,
            "text": [
              "1963: hunting banned",
              "(International Whaling",
              "Commission)"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "lineHeight": 14,
        "fontSize": 11,
        "fontWeight": 600,
        "fill": "#16212d",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              1924,
              1978
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1937.5,
            "y": 260,
            "text": [
              "No catches recorded",
              "1929–1946"
            ]
          },
          {
            "x": 1954,
            "y": 2150,
            "text": "▼ Peak: 2,039 in 1954"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "lineHeight": 14,
        "fontSize": 11,
        "fontWeight": 600,
        "fill": "#16212d",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              1924,
              1978
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
