        "fontWeight": 600,
        "lineHeight": 15,
        "tooltip": false,
        "stroke": "#d9e6f1",
        "strokeWidth": 3,
        "strokeOpacity": 0.9,
        "fill": "#d9e6f1"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
