{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "The main whale-watching season at popular spots (months holding the middle 80% of sightings), 2016-2025. Dot = busiest month.",
  "data": {
    "url": "data/c12_planner.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lat": "number",
        "records": "number",
        "start_month": "number",
        "end_month": "number",
        "peak_month": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.site + ', ' + datum.state",
      "as": "place"
    },
    {
      "calculate": "datum.end_month + 1",
      "as": "end_edge"
    },
    {
      "calculate": "datum.peak_month + 0.5",
      "as": "peak_mid"
    },
    {
      "calculate": "datum.state === 'WA' ? '3 · West coast' : (datum.state === 'VIC' || datum.state === 'SA') ? '2 · South coast' : '1 · East coast'",
      "as": "region"
    },
    {
      "calculate": "datum.site === 'Head of Bight' ? 'most southern right sightings' : datum.site === 'Hervey Bay' ? 'most humpback sightings, east' : datum.site === 'Exmouth' ? 'most humpback sightings, west' : ''",
      "as": "note"
    }
  ],
  "facet": {
    "row": {
      "field": "region",
      "type": "nominal",
      "title": null,
      "sort": "ascending",
      "header": {
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelFontSize": 12,
        "labelExpr": "slice(datum.value, 4)",
        "labelPadding": 4
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spacing": 14,
  "spec": {
    "width": 700,
    "height": {
      "step": 30
    },
    "encoding": {
      "y": {
        "field": "place",
        "type": "nominal",
        "title": null,
        "sort": {
          "field": "lat",
          "order": "descending"
        },
        "axis": {
          "labelFontSize": 12,
          "labelColor": "#16212d",
          "ticks": false,
          "domain": false,
          "labelPadding": 8,
          "minExtent": 140
        }
      },
      "opacity": {
        "condition": {
          "param": "pickSp",
          "value": 1
        },
        "value": 0.15
      },
      "tooltip": [
        {
          "field": "place",
          "title": "Place"
        },
        {
          "field": "species_name",
          "title": "Species"
        },
        {
          "field": "start_name",
          "title": "Season starts"
        },
        {
          "field": "end_name",
          "title": "Season ends"
        },
        {
          "field": "peak_name",
          "title": "Busiest month"
        },
        {
          "field": "records",
          "title": "Sightings",
          "format": ","
        }
      ]
    },
    "layer": [
      {
        "params": [
          {
            "name": "pickSp",
            "select": {
              "type": "point",
              "fields": [
                "species_name"
              ]
            },
            "bind": "legend"
          }
        ],
        "mark": {
          "type": "bar",
          "cornerRadius": 4,
          "height": {
            "band": 0.6
          }
        },
        "encoding": {
          "x": {
            "field": "start_month",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                5,
                13
              ],
              "nice": false
            },
            "axis": {
              "values": [
                5.5,
                6.5,
                7.5,
                8.5,
                9.5,
                10.5,
                11.5,
                12.5
              ],
              "labelExpr": "[\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"][floor(datum.value) - 1]",
              "grid": false,
              "ticks": false,
              "domain": false,
              "orient": "bottom"
            }
          },
          "x2": {
            "field": "end_edge"
          },
          "color": {
            "field": "species_name",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "Humpback Whale",
                "Southern Right Whale"
              ],
              "range": [
                "#2a78d6",
                "#eda100"
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal"
            }
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "fill": "#ffffff",
          "stroke": "#16212d",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "peak_mid",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.note !== ''"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 8,
          "fontSize": 11,
          "fontWeight": 600,
          "fill": "#16212d",
          "tooltip": false
        },
        "encoding": {
          "x": {
            "field": "end_edge",
            "type": "quantitative"
          },
          "text": {
            "field": "note"
          }
        }
      }
    ]
  },
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
