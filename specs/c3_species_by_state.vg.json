{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of whale species recorded off each state, 2016-2025. Offshore reports are assigned to the nearest state's coast.",
  "width": 560,
  "height": 460,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island' && datum.properties.name !== 'Jervis Bay Territory'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "species_count": "number",
                  "records": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "species_count",
              "records",
              "species_list"
            ]
          }
        },
        {
          "calculate": "isValid(datum.species_count) ? toNumber(datum.species_count) : null",
          "as": "species_count"
        },
        {
          "calculate": "isValid(datum.records) ? toNumber(datum.records) : null",
          "as": "records"
        }
      ],
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff"
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.species_count)",
            "value": "#f1f0ec"
          },
          "field": "species_count",
          "type": "ordinal",
          "title": "Species recorded",
          "scale": {
            "domain": [
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "range": [
              "#cde2fb",
              "#9ec5f4",
              "#6da7ec",
              "#3987e5",
              "#256abf",
              "#184f95",
              "#0d366b"
            ]
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverState",
            "empty": false,
            "value": 2.5
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State"
          },
          {
            "field": "species_count",
            "title": "Species recorded"
          },
          {
            "field": "records",
            "title": "Reports",
            "format": ","
          },
          {
            "field": "species_list",
            "title": "Species (most reported first)"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#ecebe7",
      "domainColor": "#cfcdc6",
      "tickColor": "#cfcdc6"
    },
    "legend": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#1d1d1b",
      "titleColor": "#52514e",
      "labelFontSize": 12,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#1d1d1b",
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#52514e"
    }
  }
}
