{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of whale species seen off each state, 2016-2025. Sightings at sea are counted for the nearest state's coast.",
  "width": 640,
  "height": 520,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#d9e6f1",
        "cornerRadius": 8,
        "tooltip": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y2": {
          "value": "height"
        }
      }
    },
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island' && datum.properties.name !== 'Jervis Bay Territory'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "species_count": "number",
                  "records": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "species_count",
              "records",
              "species_list"
            ]
          }
        },
        {
          "calculate": "isValid(datum.species_count) ? toNumber(datum.species_count) : null",
          "as": "species_count"
        },
        {
          "calculate": "isValid(datum.records) ? toNumber(datum.records) : null",
          "as": "records"
        }
      ],
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff"
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.species_count)",
            "value": "#ece7dc"
          },
          "field": "species_count",
          "type": "ordinal",
          "title": "Species recorded",
          "scale": {
            "domain": [
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "range": [
              "#cde2fb",
              "#9ec5f4",
              "#6da7ec",
              "#3987e5",
              "#256abf",
              "#184f95",
              "#0d366b"
            ]
          },
          "legend": {
            "orient": "top-right",
            "direction": "vertical",
            "fillColor": "#f3f7fa",
            "padding": 8,
            "cornerRadius": 4
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverState",
            "empty": false,
            "value": 2.5
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State"
          },
          {
            "field": "species_count",
            "title": "Species recorded"
          },
          {
            "field": "records",
            "title": "Sightings",
            "format": ","
          },
          {
            "field": "species_list",
            "title": "Kinds of whale (most seen first)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Western Australia",
            "abbr": "WA",
            "lon": 121.5,
            "lat": -26.5
          },
          {
            "state": "Northern Territory",
            "abbr": "NT",
            "lon": 133.5,
            "lat": -20.5
          },
          {
            "state": "South Australia",
            "abbr": "SA",
            "lon": 135.0,
            "lat": -30.0
          },
          {
            "state": "Queensland",
            "abbr": "QLD",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "state": "New South Wales",
            "abbr": "NSW",
            "lon": 146.5,
            "lat": -32.3
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv"
            },
            "key": "state",
            "fields": [
              "species_count"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.species_count)",
          "as": "n"
        },
        {
          "calculate": "[datum.abbr, datum.n + ' species']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "tooltip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.n >= 5",
            "value": "#ffffff"
          },
          "value": "#16212d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Tasmania",
            "abbr": "TAS",
            "lon": 151.0,
            "lat": -41.3
          },
          {
            "state": "Victoria",
            "abbr": "VIC",
            "lon": 141.4,
            "lat": -39.6
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/c3_species_by_state.csv"
            },
            "key": "state",
            "fields": [
              "species_count"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.species_count)",
          "as": "n"
        },
        {
          "calculate": "[datum.abbr, datum.n + ' species']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "tooltip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#16212d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 127.2,
            "lat": -11.2,
            "text": [
              "NT: fewest kinds,",
              "remote coast, few sightings ▶"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 0,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "tooltip": false,
        "stroke": "#d9e6f1",
        "strokeWidth": 3,
        "strokeOpacity": 0.9,
        "fill": "#d9e6f1"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 127.2,
            "lat": -11.2,
            "text": [
              "NT: fewest kinds,",
              "remote coast, few sightings ▶"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 0,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": 600,
        "lineHeight": 15,
        "tooltip": false,
        "fill": "#16212d"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null,
      "fill": "#d9e6f1",
      "cornerRadius": 6
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 13,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
