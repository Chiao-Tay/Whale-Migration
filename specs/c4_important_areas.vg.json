{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "description": "Areas the government marks as important for whales (DCCEEW Biologically Important Areas), coloured by behaviour. Pick a species or click a behaviour in the legend.",
  "width": 942,
  "height": 640,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "species_pick",
      "value": "All whales",
      "bind": {
        "input": "select",
        "name": "Show areas for: ",
        "options": [
          "All whales",
          "Humpback Whale",
          "Southern Right Whale",
          "Pygmy Blue Whale",
          "Blue and Pygmy Blue Whale",
          "Sperm Whale"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#d9e6f1",
        "cornerRadius": 8,
        "tooltip": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y2": {
          "value": "height"
        }
      }
    },
    {
      "data": {
        "url": "data/whale-bias.json",
        "format": {
          "type": "topojson",
          "feature": "whale_bias"
        }
      },
      "transform": [
        {
          "calculate": "indexof([\"Migration\", \"Reproduction\", \"Foraging\", \"Resting\"], datum.properties.BEHAVIOUR_CAT)",
          "as": "b_order"
        }
      ],
      "params": [
        {
          "name": "behaviour",
          "select": {
            "type": "point",
            "fields": [
              "properties.BEHAVIOUR_CAT"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "properties.BEHAVIOUR_CAT",
          "type": "nominal",
          "title": "What whales do here",
          "scale": {
            "domain": [
              "Migration",
              "Reproduction",
              "Foraging",
              "Resting"
            ],
            "range": [
              "#6250d6",
              "#e87ba4",
              "#3d4f61",
              "#c4cdd6"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "vertical",
            "fillColor": "#f3f7fa",
            "padding": 8,
            "cornerRadius": 4,
            "labelExpr": "{'Migration': 'Migration route', 'Reproduction': 'Calving & breeding', 'Foraging': 'Feeding', 'Resting': 'Resting'}[datum.label]"
          }
        },
        "stroke": {
          "field": "properties.BEHAVIOUR_CAT",
          "type": "nominal",
          "scale": {
            "domain": [
              "Migration",
              "Reproduction",
              "Foraging",
              "Resting"
            ],
            "range": [
              "#6250d6",
              "#e87ba4",
              "#3d4f61",
              "#c4cdd6"
            ]
          }
        },
        "order": {
          "field": "b_order",
          "sort": "descending"
        },
        "fillOpacity": {
          "condition": [
            {
              "test": "species_pick !== 'All whales' && datum.properties.COMMON_NAME !== species_pick",
              "value": 0.02
            },
            {
              "param": "behaviour",
              "value": 0.42
            }
          ],
          "value": 0.03
        },
        "strokeOpacity": {
          "condition": [
            {
              "test": "species_pick !== 'All whales' && datum.properties.COMMON_NAME !== species_pick",
              "value": 0.05
            },
            {
              "param": "behaviour",
              "value": 0.95
            }
          ],
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "properties.COMMON_NAME",
            "title": "Species"
          },
          {
            "field": "properties.BEHAVIOUR_CAT",
            "title": "Behaviour"
          },
          {
            "field": "properties.SEASON",
            "title": "When"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece7dc",
        "stroke": "#ffffff",
        "strokeWidth": 0.8,
        "tooltip": false
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 155.6,
            "lat": -14.2,
            "text": [
              "Humpback calving waters",
              "(Great Barrier Reef)"
            ]
