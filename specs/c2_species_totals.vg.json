{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "description": "Number of sightings of each whale species, 2016-2025. Humpback and southern right whales make up 97.5% of sightings.",
  "data": {
    "url": "data/c2_species_totals.csv",
    "format": {
      "type": "csv",
      "parse": {
        "records": "number"
      }
    }
  },
  "width": 806,
  "height": {
    "step": 28
  },
  "transform": [
    {
      "calculate": "indexof([\"Humpback Whale\", \"Southern Right Whale\", \"Blue Whale\"], datum.species_name) >= 0 ? datum.species_name : 'Other species'",
      "as": "colour_group"
    }
  ],
  "encoding": {
    "y": {
      "field": "species_name",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "records",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelColor": "#16212d",
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "records",
      "type": "quantitative",
      "title": null,
      "axis": {
        "grid": false,
        "labels": false,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hoverBar",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": {
          "band": 0.7
        }
      },
      "encoding": {
        "color": {
          "field": "colour_group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Humpback Whale",
              "Southern Right Whale",
              "Blue Whale",
              "Other species"
            ],
            "range": [
              "#2a78d6",
              "#eda100",
              "#1baf7a",
              "#b9c3cd"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "hoverBar",
            "empty": true,
            "value": 1
          },
          "value": 0.55
        },
        "tooltip": [
          {
            "field": "species_name",
            "title": "Species"
          },
          {
            "field": "records",
            "title": "Sightings",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "fill": "#3f4b57"
      },
      "encoding": {
        "text": {
          "field": "records",
          "format": ","
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "species_name": "Southern Right Whale",
            "records": 4409,
            "text": [
              "◀ Humpbacks + southern rights:",
              "97.5% of all sightings"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 52,
        "dy": -8,
        "lineHeight": 16,
        "fontSize": 12,
        "fontWeight": 600,
        "fill": "#16212d",
        "tooltip": false
      },
      "encoding": {
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#3f4b57",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 62
        },
        "y2": {
          "value": 274
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 820,
            "x2": 1000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#3f4b57",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "value": 62
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 820,
            "x2": 1000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#3f4b57",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "value": 274
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1000,
            "x2": 4900
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#3f4b57",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "value": 168
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 4409,
            "text": [
              "Eight other species together:",
              "349 sightings, just 2.5% of the total.",
              "Blue whales come third with 150.",
              "Omura's whale was seen only twice in ten years."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 52,
        "lineHeight": 18,
        "fontSize": 12,
        "fontWeight": 600,
        "fill": "#16212d",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 168
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 13,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
