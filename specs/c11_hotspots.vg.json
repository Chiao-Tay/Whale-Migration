{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "description": "Whale-watching hotspots: sightings in squares about 50 km wide (half a degree), 2016-2025. Circle area = number of sightings.",
  "width": 942,
  "height": 660,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#d9e6f1",
        "cornerRadius": 8,
        "tooltip": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y2": {
          "value": "height"
        }
      }
    },
    {
      "data": {
        "url": "data/australia-states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece7dc",
        "stroke": "#ffffff",
        "strokeWidth": 0.8,
        "tooltip": false
      }
    },
    {
      "data": {
        "url": "data/c11_hotspots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "records": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "indexof([\"Humpback Whale\", \"Southern Right Whale\", \"Blue Whale\"], datum.top_species) >= 0 ? datum.top_species : 'Other whale'",
          "as": "species_group"
        }
      ],
      "params": [
        {
          "name": "pickSpecies",
          "select": {
            "type": "point",
            "fields": [
              "species_group"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "records",
          "type": "quantitative",
          "title": "Sightings",
          "scale": {
            "type": "sqrt",
            "range": [
              20,
              2200
            ]
          },
          "legend": {
            "values": [
              50,
              500,
              1500
            ],
            "orient": "bottom-left",
            "symbolFillColor": "#b9c3cd",
            "fillColor": "#f3f7fa",
            "padding": 8,
            "cornerRadius": 4
          }
        },
        "color": {
          "field": "species_group",
          "type": "nominal",
          "title": "Most-seen species",
          "scale": {
            "domain": [
              "Humpback Whale",
              "Southern Right Whale",
              "Other whale"
            ],
            "range": [
              "#2a78d6",
              "#eda100",
              "#8a96a3"
            ]
          },
          "legend": {
            "orient": "top-left",
            "symbolOpacity": 1,
            "fillColor": "#f3f7fa",
            "padding": 8,
            "cornerRadius": 4
          }
        },
        "order": {
          "field": "records",
          "sort": "descending"
        },
        "opacity": {
          "condition": {
            "param": "pickSpecies",
            "value": 0.85
          },
          "value": 0.1
        },
        "tooltip": [
          {
            "field": "species_group",
            "title": "Most-seen species"
          },
          {
            "field": "records",
            "title": "Sightings",
            "format": ","
          },
          {
            "field": "lat",
            "title": "Latitude",
            "format": ".2f"
          },
          {
            "field": "lon",
            "title": "Longitude",
            "format": ".2f"
          }
        ]
      }
    },
