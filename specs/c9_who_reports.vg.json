{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Where whale sightings came from, 2016-2025. Each square is 1% of sightings.",
  "data": {
    "url": "data/c9_sources_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "square": "number",
        "col": "number",
        "row": "number",
        "source_pct": "number",
        "source_records": "number"
      }
    }
  },
  "width": 420,
  "height": 420,
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 200
  },
  "transform": [
    {
      "calculate": "datum.source === 'Scientific surveys' || datum.source === 'Museum collections' ? 'Scientific surveys & museums' : datum.source",
      "as": "source_group"
    },
    {
      "calculate": "{'Citizen science apps': 'Apps & websites', 'Government wildlife atlases': 'Government atlases', 'Scientific surveys & museums': 'Surveys & museums'}[datum.source_group]",
      "as": "source_name"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "group_pct"
        }
      ],
      "groupby": [
        "source_group"
      ]
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "pickSource",
          "select": {
            "type": "point",
            "fields": [
              "source_group"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "square",
        "size": 1120,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "source_group",
          "type": "nominal",
          "title": "Sightings came from",
          "scale": {
            "domain": [
              "Citizen science apps",
              "Government wildlife atlases",
              "Scientific surveys & museums"
            ],
            "range": [
              "#008300",
              "#7c8a99",
              "#c4cdd6"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 440,
            "legendY": 165,
            "direction": "vertical",
            "labelLimit": 300,
            "labelFontSize": 13,
            "titleFontSize": 13,
            "symbolSize": 180,
            "rowPadding": 8,
            "labelExpr": "{'Citizen science apps': 'Apps & websites · 56%', 'Government wildlife atlases': 'Government atlases · 39.5%', 'Scientific surveys & museums': 'Surveys & museums · 4.5%'}[datum.label]"
          }
        },
        "opacity": {
          "condition": {
            "param": "pickSource",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "source_name",
            "title": "Came from"
          },
          {
            "field": "group_pct",
            "title": "% of sightings"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 210,
            "y": 107,
            "text": "56%",
            "halo": "#005c00"
          },
          {
            "x": 210,
            "y": 334,
            "text": "39.5%",
            "halo": "#4e5a66"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 32,
        "fontWeight": 800,
        "tooltip": false,
        "baseline": "middle",
        "strokeWidth": 7,
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "text"
        },
        "stroke": {
          "field": "halo",
          "type": "nominal",
          "scale": null
        },
        "fill": {
          "field": "halo",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 210,
            "y": 107,
            "text": "56%",
            "halo": "#005c00"
          },
          {
            "x": 210,
            "y": 334,
            "text": "39.5%",
            "halo": "#4e5a66"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 32,
        "fontWeight": 800,
        "tooltip": false,
        "baseline": "middle",
        "fill": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#3f4b57",
      "titleColor": "#3f4b57",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "gridColor": "#d6e0ea",
      "domainColor": "#b9c6d3",
      "tickColor": "#b9c6d3"
    },
    "legend": {
      "labelColor": "#3f4b57",
      "titleColor": "#16212d",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 0
    },
    "header": {
      "labelColor": "#16212d",
      "titleColor": "#3f4b57",
      "labelFontSize": 12,
      "labelFontWeight": 600
    },
    "title": {
      "color": "#16212d",
      "fontSize": 13,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#3f4b57"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif"
    }
  }
}
