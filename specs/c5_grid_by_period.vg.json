{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "description": "Whale sightings in squares about 100 km wide (1 degree), two months at a time, 2016-2025.",
  "vconcat": [
    {
      "hconcat": [
        {
          "title": {
            "text": "Jan – Feb · 29 sightings",
            "fontSize": 13,
            "fontWeight": 600,
            "color": "#16212d"
          },
          "width": 298,
          "height": 250,
          "projection": {
            "type": "conicEqualArea",
            "parallels": [
              -18,
              -36
            ],
            "rotate": [
              -132,
              0,
              0
            ]
          },
          "layer": [
            {
              "data": {
                "values": [
                  {}
                ]
              },
              "mark": {
                "type": "rect",
                "fill": "#d9e6f1",
                "cornerRadius": 8,
                "tooltip": false
              },
              "encoding": {
                "x": {
                  "value": 0
                },
                "y": {
                  "value": 0
                },
                "x2": {
                  "value": "width"
                },
                "y2": {
                  "value": "height"
                }
              }
            },
            {
              "data": {
                "url": "data/australia-states.json",
                "format": {
                  "type": "topojson",
                  "feature": "australia_states"
                }
              },
              "transform": [
                {
                  "filter": "datum.properties.name !== 'Macquarie Island' && datum.properties.name !== 'Lord Howe Island'"
                }
              ],
              "mark": {
                "type": "geoshape",
                "fill": "#ece7dc",
                "stroke": "#ffffff",
                "strokeWidth": 0.8,
                "tooltip": false
              }
            },
            {
              "data": {
                "url": "data/c5_grid_by_period.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "period_order": "number",
                    "lat_bin": "number",
                    "lon_bin": "number",
                    "records": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.period === 'Jan-Feb'"
                }
              ],
              "mark": {
                "type": "square",
                "size": 40,
                "opacity": 0.95
              },
              "encoding": {
                "longitude": {
                  "field": "lon_bin",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat_bin",
                  "type": "quantitative"
                },
                "color": {
                  "field": "records",
                  "type": "quantitative",
                  "title": "Sightings per square",
                  "scale": {
                    "type": "log",
                    "domain": [
                      1,
                      1000
                    ],
                    "clamp": true,
                    "range": [
                      "#9ec5f4",
                      "#0d366b"
                    ]
                  },
                  "legend": {
                    "orient": "bottom",
                    "direction": "horizontal",
                    "gradientLength": 240,
                    "values": [
                      1,
                      10,
                      100,
                      1000
                    ]
                  }
                },
                "tooltip": [
                  {
                    "field": "period",
                    "title": "Months"
                  },
                  {
                    "field": "records",
                    "title": "Sightings",
                    "format": ","
                  },
                  {
                    "field": "lat_bin",
                    "title": "Latitude",
                    "format": ".1f"
                  },
                  {
                    "field": "lon_bin",
                    "title": "Longitude",
                    "format": ".1f"
                  }
                ]
              }
            },
            {
              "data": {
                "values": [
                  {
                    "lon": 133.5,
                    "lat": -27.0,
                    "text": [
                      "Almost empty: whales are",
                      "feeding in Antarctica"
                    ]
                  }
                ]
              },
              "mark": {
                "type": "text",
                "align": "center",
                "dx": 0,
                "dy": 0,
                "fontSize": 12,
                "fontWeight": 600,
                "lineHeight": 15,
                "tooltip": false,
                "fill": "#16212d"
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "text"
                }
              }
            }
          ]
        },
